# Toolchain del portal de documentación (site/, Astro + Starlight)
node_modules/
dist/
.astro/

# Contenido del portal generado desde docs/ por site/scripts/sync-docs.mjs.
# La fuente es docs/; esto se regenera en cada build y no se versiona.
site/src/content/docs/

# Caché de lychee (verificación de enlaces externos)
.lycheecache

# Secretos: se configuran como variables de entorno, nunca versionados (AGENTS.md §7).
# La plantilla sin valores sí se versiona.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Sistema operativo y editores
.DS_Store
