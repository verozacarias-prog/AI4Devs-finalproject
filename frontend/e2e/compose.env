# The variables of the end-to-end stack (#79). Invented values for a database that lives only
# while the test runs: nothing here is a secret.
POSTGRES_USER=platita
POSTGRES_PASSWORD=platita
POSTGRES_DB=platita
# Not the ports of `docker compose up`, so both can run at once.
DB_PORT=5434
API_PORT=8001
APP_ENV=local
DEV_ENTRY_ENABLED=true
WEB_CHAT_ENABLED=true
# The worker does not start without a key. The fake provider does not read it.
OPENAI_API_KEY=not-a-real-key
