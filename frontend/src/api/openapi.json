          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevUsers"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Users",
        "tags": [
          "dev"
        ]
      }
    },
