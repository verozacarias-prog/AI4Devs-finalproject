    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "typescript": "~5.9",
    "vite": "^8.3.0",
