# Copy to .env and adjust. The .env file is never committed (AGENTS.md §7).
# These values are for the local environment only.

# Database started by Docker Compose.
POSTGRES_USER=platita
POSTGRES_PASSWORD=platita
POSTGRES_DB=platita
# Port on your machine. 5433 avoids clashing with a PostgreSQL already running on 5432.
DB_PORT=5433

# API.
API_PORT=8000
# One of: local, demo, production.
APP_ENV=local
APP_VERSION=dev

# Folder with the compiled dashboard, served under /app. The image sets it; outside Docker,
# leave it unset to run the API alone, or point it at frontend/dist after `npm run build`.
# DASHBOARD_DIR=../frontend/dist

# To run the backend or its tests outside Docker, against the Compose database:
# DATABASE_URL=postgresql+psycopg://platita:platita@127.0.0.1:5433/platita
# TEST_DATABASE_URL=postgresql+psycopg://platita:platita@127.0.0.1:5433/platita
