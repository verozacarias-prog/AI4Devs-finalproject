# Copy to .env and adjust. The .env file is never committed (AGENTS.md §7).
# These values are for the local environment only.

# Database started by Docker Compose.
POSTGRES_USER=platita
POSTGRES_PASSWORD=platita
POSTGRES_DB=platita
# Port on your machine. 5433 avoids clashing with a PostgreSQL already running on 5432.
DB_PORT=5433

# API.
API_PORT=8000
# One of: local, demo, production.
APP_ENV=local
APP_VERSION=dev
# The development entry: opens a session without a login code, choosing a test user. true or
# false; without it, it is off. With true and APP_ENV=production no process starts.
DEV_ENTRY_ENABLED=true
# The chat of the dashboard, answered by the worker. Same rules as the development entry.
WEB_CHAT_ENABLED=true

# The key of the language model (ADR 0025). Only the worker reads it, and without it the worker
# does not start. Never commit it: .env is ignored by git.
OPENAI_API_KEY=

# Optional. How long a pending message may wait before GET /queuez fails, in minutes
# (default 10), and how long a message stays taken by one worker, in seconds (default 120).
# A whole number greater than zero; with any other value the process does not start.
# QUEUE_MAX_WAIT_MINUTES=10
# WORKER_LOCK_SECONDS=120

# Optional. The longest a call to the model may take, in seconds (default 20): it must be less
# than WORKER_LOCK_SECONDS, or no process starts. And the retries of a message whose call
# failed: how many attempts (default 3), and the wait before the second one and the longest
# wait, in seconds (defaults 30 and 120); each wait is four times the one before.
# LLM_TIMEOUT_SECONDS=20
# MESSAGE_MAX_ATTEMPTS=3
# MESSAGE_RETRY_FIRST_WAIT_SECONDS=30
# MESSAGE_RETRY_MAX_WAIT_SECONDS=120

# Folder with the compiled dashboard, served under /app. The image sets it; outside Docker,
# leave it unset to run the API alone, or point it at frontend/dist after `npm run build`.
# DASHBOARD_DIR=../frontend/dist

# To run the backend or its tests outside Docker, against the Compose database:
# DATABASE_URL=postgresql+psycopg://platita:platita@127.0.0.1:5433/platita
# TEST_DATABASE_URL=postgresql+psycopg://platita:platita@127.0.0.1:5433/platita
