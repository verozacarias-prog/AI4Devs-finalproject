{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/id_rsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials*)",
      "Read(**/service-account*.json)"
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "fastapi-harness@fastapi-harness": true
  },
  "extraKnownMarketplaces": {
    "fastapi-harness": {
      "source": {
        "source": "github",
        "repo": "verozacarias-prog/fastapi-harness",
        "ref": "v0.4.0"
      }
    }
  }
}
